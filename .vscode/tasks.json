{
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: cl.exe 生成活动文件",
			"command": "cl.exe",
			"args": [
				"/Zi",
				"/EHsc",
				"/nologo",
				"/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
				"${file}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build",
			"detail": "调试器生成的任务。"
		},
		{
			"label": "cargo check resvg bridge",
			"type": "shell",
			"command": "cargo",
			"args": [
				"check",
				"--manifest-path",
				"third_party/resvg_bridge/Cargo.toml"
			],
			"group": "build"
		},
		{
			"label": "cargo build resvg bridge",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--manifest-path",
				"third_party/resvg_bridge/Cargo.toml"
			],
			"group": "build"
		}
	],
	"version": "2.0.0"
}